# Copy these settings into the existing private .env.local. Never commit real credentials.
# Free API keys work through the existing Telegram BOT_API_TOKEN; no wallet needed.
MCP_DATA_DIR=data/mcp

# Payments stay OFF until the operator supplies their receiving wallet and reviews source rights.
MCP_CRYPTO_ENABLED=0
MCP_BSC_WALLET=
MCP_COMMERCIAL_RIGHTS_CONFIRMED=0

# Read-only HTTPS RPC, BNB Smart Chain mainnet chain ID 56.
# Must support eth_getLogs, finalized blocks, receipts and eth_call. No signing key needed.
BSC_RPC_URL=https://bsc-rpc.publicnode.com

# Keep IMDb rating redistribution disabled without the necessary commercial licence.
MCP_LICENSED_RATINGS=0
