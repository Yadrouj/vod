<?xml version="1.0" encoding="utf-8"?>
<!-- Shared native layout: tags are the binding contract for both package IDs. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent" android:layout_height="match_parent"
  android:background="#070A10" android:layoutDirection="rtl"
  android:clickable="true" android:focusable="true" android:focusableInTouchMode="true"
  android:descendantFocusability="blocksDescendants">
  <ir.sarvnema.shell.CinematicBackdrop android:tag="startup_cinema"
    android:layout_width="match_parent" android:layout_height="match_parent" />
  <ScrollView android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:scrollbars="none" android:overScrollMode="never">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="vertical" android:gravity="center" android:padding="@dimen/startup_spacing">
      <LinearLayout android:tag="startup_brand" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:text="@string/startup_eyebrow" android:textColor="#E8C57D" android:textSize="@dimen/startup_status_size"
          android:fontFamily="@font/alibaba_regular" android:layout_marginBottom="12dp" android:gravity="center" />
        <FrameLayout android:layout_width="@dimen/startup_halo_size" android:layout_height="@dimen/startup_halo_size">
          <View android:tag="startup_halo" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/startup_logo_glow" android:importantForAccessibility="no" />
          <ImageView android:tag="startup_mark" android:layout_gravity="center"
            android:layout_width="@dimen/startup_logo_size" android:layout_height="@dimen/startup_logo_size"
            android:src="@drawable/brand_foreground" android:scaleType="fitCenter" android:importantForAccessibility="no" />
        </FrameLayout>
        <TextView android:tag="startup_title" android:layout_width="match_parent" android:layout_height="wrap_content"
          android:text="@string/app_name" android:textColor="#FFF8E9" android:textSize="@dimen/startup_title_size"
          android:gravity="center" android:fontFamily="@font/alibaba_black" android:includeFontPadding="false"
          android:shadowColor="#99000000" android:shadowRadius="12" android:shadowDy="2"
          android:accessibilityHeading="true" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
          android:text="@string/brand_slogan" android:textColor="#E4D9C3" android:textSize="@dimen/startup_slogan_size"
          android:gravity="center" android:fontFamily="@font/alibaba_regular" />
      </LinearLayout>
      <ProgressBar android:tag="startup_progress" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="@dimen/startup_meter_width" android:layout_height="4dp" android:layout_marginTop="@dimen/startup_spacing"
        android:max="100" android:indeterminate="false" android:progress="0" android:layoutDirection="ltr"
        android:progressDrawable="@drawable/startup_progress" android:importantForAccessibility="no" />
      <TextView android:tag="startup_status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="14dp" android:text="@string/startup_loading" android:textColor="#BFC5CC"
        android:fontFamily="@font/alibaba_regular" android:textSize="@dimen/startup_status_size"
        android:gravity="center" android:accessibilityLiveRegion="polite" />
    </LinearLayout>
  </ScrollView>
</FrameLayout>
