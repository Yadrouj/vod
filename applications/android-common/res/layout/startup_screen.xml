<?xml version="1.0" encoding="utf-8"?>
<!-- Shared resource contract: tags allow both package IDs to use the same controller. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent" android:layout_height="match_parent"
  android:background="@drawable/startup_background" android:fillViewport="true"
  android:scrollbars="none" android:overScrollMode="never"
  android:clickable="true" android:focusable="true" android:focusableInTouchMode="true"
  android:descendantFocusability="blocksDescendants" android:layoutDirection="rtl">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:gravity="center" android:padding="@dimen/startup_spacing">
    <LinearLayout android:tag="startup_brand" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="vertical" android:gravity="center">
      <ImageView android:tag="startup_mark" android:layout_width="@dimen/startup_logo_size" android:layout_height="@dimen/startup_logo_size"
        android:src="@drawable/brand_foreground" android:scaleType="fitCenter" android:importantForAccessibility="no" />
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/app_name" android:textColor="#F4F4F4" android:textSize="@dimen/startup_title_size"
        android:textStyle="bold" android:gravity="center" android:fontFamily="sans-serif" android:includeFontPadding="false"
        android:accessibilityHeading="true" />
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
        android:text="@string/brand_slogan" android:textColor="#C4CBCF" android:textSize="@dimen/startup_slogan_size"
        android:gravity="center" android:fontFamily="sans-serif" />
    </LinearLayout>
    <ProgressBar android:tag="startup_progress" style="?android:attr/progressBarStyleHorizontal"
      android:layout_width="160dp" android:layout_height="3dp" android:layout_marginTop="@dimen/startup_spacing"
      android:max="100" android:indeterminate="false" android:progress="0" android:layoutDirection="ltr"
      android:progressTint="@color/brand_accent" android:progressBackgroundTint="#303940"
      android:importantForAccessibility="no" />
    <TextView android:tag="startup_status" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:layout_marginTop="16dp" android:text="@string/startup_loading" android:textColor="#9EAAB0"
      android:textSize="@dimen/startup_status_size" android:gravity="center" android:accessibilityLiveRegion="polite" />
  </LinearLayout>
</ScrollView>
