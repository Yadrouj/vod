 break a lot of glass in the process.","imageUrl":"https://static.tvmaze.com/uploads/images/medium_landscape/398/997449.jpg","imageSource":"tvmaze","imageAlt":null,"imagePosition":null},{"season":1,"episode":63,"title":"Velikonoční Vajíčko","summary":null,"imageUrl":"https://static.tvmaze.com/uploads/images/medium_landscape/399/997874.jpg","imageSource":"tvmaze","imageAlt":null,"imagePosition":null},{"season":1,"episode":64,"title":"Štíhlá Linie","summary":null,"imageUrl":"https://static.tvmaze.com/uploads/images/medium_landscape/399/998183.jpg","imageSource":"tvmaze","imageAlt":null,"imagePosition":null},{"season":1,"episode":65,"title":"Automat","summary":null,"imageUrl":"https://static.tvmaze.com/uploads/images/medium_landscape/399/998386.jpg","imageSource":"tvmaze","imageAlt":null,"imagePosition":null},{"season":1,"episode":66,"title":"Autodráha","summary":null,"imageUrl":"https://static.tvmaze.com/uploads/images/medium_landscape/399/998731.jpg","imageSource":"tvmaze","imageAlt":null,"imagePosition":null},{"season":1,"episode":67,"title":"Akvárium","summary":null,"imageUrl":null,"imageSource":null,"imageAlt":null,"imagePosition":null},{"season":1,"episode":68,"title":"Zavařují","summary":null,"imageUrl":null,"imageSource":null,"imageAlt":null,"imagePosition":null},{"season":1,"episode":69,"title":"Rogalo","summary":null,"imageUrl":"https://static.tvmaze.com/uploads/images/medium_landscape/401/1002819.jpg","imageSource":"tvmaze","imageAlt":null,"imagePosition":null},{"season":1,"episode":70,"title":"Vánočka","summary":null,"imageUrl":"https://static.tvmaze.com/uploads/images/medium_landscape/401/1002820.jpg","imageSource":"tvmaze","imageAlt":null,"imagePosition":null},{"season":1,"episode":71,"title":"Stůňou","summary":null,"imageUrl":"https://static.tvmaze.com/uploads/images/medium_landscape/401/1003140.jpg","imageSource":"tvmaze","imageAlt":null,"imagePosition":null},{"season":1,"episode":72,"title":"Fax","summary":null,"imageUrl":"https://static.tvmaze.com/upl