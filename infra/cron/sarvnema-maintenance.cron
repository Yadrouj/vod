# Alternative to the Docker maintenance service. Install this on the Linux host
# only when Docker Compose does not run the `maintenance` service.
# The script itself verifies the Asia/Tehran idle window, current app traffic,
# active watch rooms, memory and load before it starts any crawler.
# Host timezone does not matter: the worker gates precisely 03:00 <= Tehran < 07:00.
# This is a ROOT crontab entry (not /etc/cron.d syntax). Match the deployment path.
*/15 * * * * cd /home/ubuntu/vod && /usr/bin/flock -n /tmp/sarvnema-maintenance.lock /usr/bin/docker compose -f docker-compose.prod.yml run --rm --no-deps maintenance node scripts/maintenance-scheduler.mjs >> /var/log/sarvnema-maintenance.log 2>&1
