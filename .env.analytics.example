# Copy values into your existing private server environment. Never commit keys.
# Existing SARVNEMA_ADMIN_TOKEN is reused for admin login; no default password.
SARVNEMA_ADMIN_TOKEN=
# Use a separate random value (32+ bytes) to keep retention identities stable
# when the admin access token changes. Never expose it as NEXT_PUBLIC_*.
SARVNEMA_ANALYTICS_SECRET=
SARVNEMA_ANALYTICS_ENABLED=1
# Must be PRIVATE, writable, persistent, and OUTSIDE public/.
SARVNEMA_ANALYTICS_DIR=data/analytics
